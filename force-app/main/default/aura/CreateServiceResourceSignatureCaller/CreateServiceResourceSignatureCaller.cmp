<aura:component implements="lightning:isUrlAddressable,forceCommunity:availableForAllPageTypes">
    <aura:attribute name="refRecordId" type="String" />
    <aura:attribute name="sObjectName" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.reInit}" />
    <c:serviceResourcesSignature recordId="{!v.refRecordId}" objectName="{!v.sObjectName}" />
</aura:component>