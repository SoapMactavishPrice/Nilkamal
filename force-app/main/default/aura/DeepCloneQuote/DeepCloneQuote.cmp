<aura:component controller="DeepCloneQuoteController" implements="force:lightningQuickActionWithoutHeader,force:hasRecordId,force:hasSObjectName">
    <lightning:navigation aura:id="navService" />

    <aura:attribute name="pageReference" type="Object" />
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="isLoading" type="Boolean" default="false" />

    <aura:handler name="init" action="{!c.cloneQuote}" value="{!this}" />
    <!-- <aura:handler name="init" value="{!this}" action="{!c.cloneQuote}" /> -->

    <aura:if isTrue="{!v.isLoading}">
        <lightning:spinner alternativeText="Cloning Quote..." size="medium" />
    </aura:if>

</aura:component>