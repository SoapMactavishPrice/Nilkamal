                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Repair Start Time</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!repairStartTimeIST}</td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Repair End Time</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!repairEndTimeIST}</td>
                        </tr>
                    </table>
                </apex:outputPanel>
                
                <!-- P02 (TTO): Completion of Service (same structure as P03) -->
                <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P02'}">
                    <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 20px 0;font-size: 12px;">
                        <tr>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Completion of Service</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>From</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!serviceCheckInDate}</td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>To</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!serviceCheckOutDate}</td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Checkin Time</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!serviceCheckIn}</td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Checkout Time</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!serviceCheckOut}</td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Repair Start Time</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!repairStartTimeIST}</td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;"><b>Repair End Time</b></td>
                            <td style="border: 1px solid black;padding: 8px;text-align: center;">{!repairEndTimeIST}</td>
                        </tr>
                    </table>
                </apex:outputPanel>
                
                <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 20px 0;font-size: 12px;">
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Service Rating</b></td>
                        <td style="border: 1px solid #000; padding: 8px;">
                            <!-- Prefer Service_Rating__c if populated, otherwise fall back to Customer_Feedback__c -->
                            <apex:outputText value="{!IF(NOT(ISBLANK(record.Service_Rating__c)), record.Service_Rating__c, record.Customer_Remark__c)}"/>
                        </td>
                        <td class="label" style="border: 1px solid #000;padding: 8px;border-right: 1px solid #000;"><b>Customer Email ID</b></td>
                        <td style="border: 1px solid #000; padding: 8px;">{!record.Customer_Email__c}</td>
                        <apex:outputPanel rendered="{!OR(record.Case__r.Asset.Product2.Material_Group_5__c == 'P01', record.Case__r.Asset.Product2.Material_Group_5__c == 'P02', record.Case__r.Asset.Product2.Material_Group_5__c == 'P03')}">
                            <td class="label" style="border: 1px solid #000;padding: 8px;border-right: 1px solid #000;border-left: 1px solid #000;"><b>Customer Feedback</b></td>
                            <td style="border: 1px solid #000; padding: 8px; border-left: 1px solid #000;">{!record.Customer_Remark__c}</td>
                        </apex:outputPanel>
                    </tr>
                </table>
            </div>
            
            <!-- Common Customer Acceptance and Service Engineer -->
            <table class="table-container" style="page-break-inside:avoid;width: 100%;border-collapse: collapse;margin: 20px 0;font-size: 12px;">
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px; width:40%">
                        <p style="text-align:center; margin-top: 5px; padding: 2px;"><b>Customer's Acceptance</b></p>
                        <p style="text-align:left; margin: 0; padding: 2px;">Name : {!record.Signature_by__c}</p>
                        <p style="text-align:left; margin: 0; padding: 2px;">Mobile No : {!record.Customer_Contact_Number__c}</p>
                        <p style="text-align:left; margin: 0; padding: 2px;">Sign &amp; Stamp</p>
                        <apex:outputText value="{!record.Signature__c}" escape="false" />
                        <p style="text-align:left; margin: 5px 0 0 0; padding: 2px;">
                            Date : 
                            <apex:outputText value="{0,date,dd MMM yyyy}">
                                <apex:param value="{!record.SR_End_Date__c}"/>
                            </apex:outputText>
                        </p>
                    </td>
                    <td class="label" style="border: 1px solid #000;padding: 0px; width:60%">
                        <table class="report-table" style="width: 100%;border-collapse: collapse;">
                            <tr>
                                <th style="border: 1px solid black;padding: 4px;text-align: left;width:33%; border-left:none;"><b>Service Engineer Name</b></th>
                                <th style="border: 1px solid black;padding: 4px;text-align: left;width:33%;border-right:none;"><b>Mobile No</b></th>
                                <th style="border: 1px solid black;padding: 4px;text-align: left; width:33%"><b>Email Id</b></th>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black;padding: 20px;text-align: left; border-left:none;">{!record.case__r.Owner.Name}</td>
                                <td style="border: 1px solid black;padding: 20px;text-align: left;border-right:none;">{!record.case__r.Owner.Phone}</td>
                                <td style="border: 1px solid black;padding: 20px;text-align: left;border-right:none;">{!record.case__r.Owner.Email}</td>
                            </tr>
                            <apex:outputText rendered="{!NOT(ISNULL(additionalResourceServiceAppointments))}">
                                <apex:repeat value="{!additionalResourceServiceAppointments}" var="additionalResource">
                                    <tr>
                                        <td style="border: 1px solid black;padding: 20px;text-align: left; border-left:none;">{!additionalResource.Owner.Name}</td>
                                        <td style="border: 1px solid black;padding: 20px;text-align: left;border-right:none;">{!additionalResource.Owner.Phone}</td>
                                        <td style="border: 1px solid black;padding: 20px;text-align: left;border-right:none;">{!additionalResource.Owner.Email}</td>
                                    </tr>
                                </apex:repeat>
                            </apex:outputText>
                        </table>
                        <p style="text-align:left; margin: 5px 0 0 0; padding: 2px;">
                            Date : 
                            <apex:outputText value="{0,date,dd MMM yyyy}">
                                <apex:param value="{!record.SR_End_Date__c}"/>
                            </apex:outputText>
                        </p>
                    </td>
                </tr>
            </table>
        </apex:outputPanel>
    </body>
</apex:page>