<apex:page standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" showHeader="false" controller="ServiceReportPdfController" renderAs="pdf">
    <head>
        <style>
            @page {
                padding-top: 70px;
                margin-bottom:70px;
                @top-center {
                    content: element(header);
                }
                @bottom-right {
                    content: element(footer);
                }
            }
            
            div.header {
                padding: 10px;
                display: block;
                position: running(header);
            }
            div.footer {
                width: 98%;
                padding: 5px;
                display: block;
                text-align: right;
                position: running(footer);
            }
            .pagenumber:before {
                content: counter(page);
            }
            .pagecount:before {
                content: counter(pages);
            }
            
            body {
                padding-top: 20px;
                /* Enforce a consistent base font size across the document */
                font-size: 12px;
            }
            
            .pdf-table-input{
                width: 100%;
                border: 1px solid #000;
                border-top: 1px solid #000;;
                border-bottom: 1px solid #000;;
            }
            .table-container {
                width: 100%;
                border-collapse: collapse;
                margin: 20px 0;
                /* Align font size with header/detail tables so all field values look consistent */
                font-size: 12px;
            }
            .table-container td {
                border: 1px solid #000;
                padding: 8px;
            }
            .table-container td.label {
                font-weight: bold;
                text-align: left;
            }
            .wrap-text {
                /* Improve readability for long textarea content (e.g. Customer's Comments) */
                white-space: pre-wrap;          /* keep user line breaks */
                word-wrap: break-word;          /* legacy break support */
                overflow-wrap: break-word;      /* modern break support */
                word-break: break-word;         /* force-break very long words */
                line-height: 1.3;
                font-size: 11px;                /* slightly smaller to fit more text */
                text-align: left;
            }
            .main-table {
                width: 100%;
                border-collapse: collapse;
                margin: 20px 0;
                font-size: 9px;
            }
            .main-table td {
                border: 1px solid #000;
                padding: 8px;
                text-align: left;
            }
            table {
                width: 100%;
                border-collapse: collapse;
            }
            .header-cell {
                text-align: left;
                font-weight: bold;
                padding: 3px 5px;
                margin-top:9px !important; 
            }
        </style>
    </head>
    
    <body>
        <!-- <apex:outputPanel rendered="{!isPreview}">
            <img src="{!URLFOR($Resource.Watermark)}" width="100%" height="100%" style="position: fixed;background-repeat:repeat;left: 0cm; top:0cm; z-index:0" />
        </apex:outputPanel> -->
        
        <!-- Common Header Section for all printer families (P01, P02, P03) -->
        <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P01' || record.Case__r.Asset.Product2.Material_Group_5__c == 'P02' || record.Case__r.Asset.Product2.Material_Group_5__c == 'P03'}">
            <div class="header">
                <table style="width:100%;border:none;margin-top:10px; border-collapse: collapse;">
                    <tr>
                        <td style="padding-left:110px;border-collapse:collapse;text-align:center;">
                            <strong style="width:100%; font-size:15px; font-family:Times New Roman;"><i>Nilkamal Limited</i></strong>
                            <strong>
                                <p style="margin:0px;font-size:10px;">SERVICE DIVISION</p>
                            </strong>
                        </td>
                        <td style="padding:5px 5px;font-size:16px;border-collapse: collapse;width:10%;">
                            <img style="width:100px;height:50px" alt="logo" src="{!$Resource.NilkamalLogo}"/>
                        </td>
                    </tr>
                    <h6 style="font-family : Microsoft Sans Serif; text-align:center; font-size: 10px;margin:0px;padding:0px;">
                        Regd. / Administrative Office : Nilkamal Houce, Plot No. 77/78, Street No.14, M.I.D.C., Andheri (E) , Mumbai - 93.
                        <br/>Tel: (022) 4235 8825 Mobile : 80077 73280 Fax : 98230 38284 E-mail : mhe.services@nilkamal.com
                    </h6>
                </table>
            </div>
            
            <div class="footer">
                <div>Page <span class="pagenumber"/> of <span class="pagecount"/></div>
            </div>
            
            <table style="width: 100%;border-collapse: collapse; margin-bottom: 10px;padding:10%;">
                <tr>
                    <td style="text-align: left; width: 33%; font-size: 12px;">No. {!record.Name}</td>
                    <td style="text-align: center; width: 34%; font-size: 12px;">SERVICE REPORT</td>
                    <td style="width: 33%; font-size: 12px;text-align: right;">
                        Date : 
                        <apex:outputText value="{0,date,dd MMM yyyy}">
                            <apex:param value="{!today}"/>
                        </apex:outputText>
                    </td>
                </tr>
            </table>
            
            <!-- Common Service Details Section -->
            <table style="width: 100%; font-size: 12px; border-collapse: collapse; margin: 20px 0;">
                <tr>
                    <td style="border: 1px solid #000; padding: 8px;"><b>Customer Name</b></td>
                    <td colspan="3" style="border: 1px solid #000; padding: 8px;">{!record.Case__r.Account.Name}</td>
                    <td style="border: 1px solid #000; padding: 8px;"><b>Party Code</b></td>
                    <td style="border: 1px solid #000; padding: 8px;">{!record.Case__r.Account.SAP_Customer_code__c}</td>
                </tr>
                <tr>
                    <td style="border: 1px solid #000; padding: 8px;"><b>Contact Person</b></td>
                    <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Case__r.Contact.Name}</td>
                    <td style="border: 1px solid #000; padding: 8px;"><b>Contact No.</b></td>
                    <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Case__r.ContactMobile}</td>
                </tr>
                
                <!-- P01 Specific Model Details -->
                <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P01'}">
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>CIJ Model No.</b></td>
                        <!-- Previously changed to use CIJ_Model_No__c; reverting to original Product__r.ProductCode for now -->
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.Product__r.ProductCode}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Sr. No.</b></td>
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.Case__r.Asset.SerialNumber}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Software. No.</b></td>
                        <td style="border: 1px solid #000; padding: 8px;">{!record.Software_No__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Customer Application</b></td>
                        <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Customer_Application__c}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Pump Run Hours</b></td>
                        <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Pump_Run_Hours__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Nozzle Serial No</b></td>
                        <td colspan="5" style="border: 1px solid #000; padding: 8px;">{!record.Nozzle_Serial_No__c}</td>
                    </tr>
                </apex:outputPanel>
                
                <!-- P03 Specific Model Details -->
                <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P03'}">
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>TIJ Model No.</b></td>
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.TIJ_Model_No__c}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Sr. No.</b></td>
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.Case__r.Asset.SerialNumber}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Software No.</b></td>
                        <td style="border: 1px solid #000; padding: 8px;">{!record.Software_No__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Product Counter</b></td>
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.Product_Counter__c}</td>
                        <td style="border: 1px solid #000; padding: 8px;"></td>
                        <td style="border: 1px solid #000; padding: 8px;"></td>
                        <td style="border: 1px solid #000; padding: 8px;"></td>
                        <td style="border: 1px solid #000; padding: 8px;"></td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Customer Application</b></td>
                        <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Customer_Application__c}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Used Ink Cartridge</b></td>
                        <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Ink_Cartridge_Part__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Cartridge Exp Date</b></td>
                        <td colspan="5" style="border: 1px solid #000; padding: 8px;">
                            <apex:outputText value="{!record.Cartridge_Exp_Date__c}"/>
                        </td>
                    </tr>
                </apex:outputPanel>

                <!-- P02 (TTO) Specific Model Details - shown below Contact Person like CIJ -->
                <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P02'}">
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>TTO Model No.</b></td>
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.TTO_Model_No__c}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Sr. No.</b></td>
                        <td colspan="1" style="border: 1px solid #000; padding: 8px;">{!record.Case__r.Asset.SerialNumber}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Software No.</b></td>
                        <td style="border: 1px solid #000; padding: 8px;">{!record.Software_No__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Customer Application</b></td>
                        <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Customer_Application_TTO__c}</td>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Print Head Kms</b></td>
                        <td colspan="2" style="border: 1px solid #000; padding: 8px;">{!record.Print_head_Kms__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Product Counter</b></td>
                        <td colspan="5" style="border: 1px solid #000; padding: 8px;">{!record.Product_Counter__c}</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;"><b>Head Serial Number</b></td>
                        <td colspan="5" style="border: 1px solid #000; padding: 8px;">{!record.Head_Serial_Number__c}</td>
                    </tr>
                </apex:outputPanel>
            </table>
            <!-- Common Type of Service -->
            <!-- Type of Service -->
            <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 20px 0; font-size: 12px;">
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px;width:20%;"><b>Type of Service</b></td>
                    <td style="border: 1px solid #000;padding: 8px;width:85%;">{!record.Case__r.Case_Sub_Type__c}</td>
                </tr>
            </table>

            <!-- Common Complaint Details -->
            <!-- Complaint Details -->
            <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 20px 0; font-size: 12px;">
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px;border-right: 1px solid #000;width:20%;"><b>Complaint Details (Write Specific)</b></td>
                    <td style="border: 1px solid #000;padding: 8px;">{!record.Complaint_Details__c}</td>
                </tr>
            </table>

            <!-- Common Service Report Observations -->
            <apex:outputPanel rendered="{!sroList.size > 0}">
                <div style="page-break-inside:avoid;">
                    <!-- Service Report Observations -->
                    <table class="table-container" style="width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 12px; border: 1px solid #000;">
                        <thead class="label" style="border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Cause</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Sub Cause</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Actual Observation by Engineer</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Correction</td>
                            </tr>
                        </thead>
                        <tbody>
                            <apex:repeat value="{!sroList}" var="rca">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px;">{!rca.Cause__c}</td>
                                    <td style="border: 1px solid #000; padding: 8px;">{!rca.Sub_Cause__c}</td>
                                    <td style="border: 1px solid #000; padding: 8px;">{!rca.Actual_Observation_by_Engineer__c}</td>
                                    <td style="border: 1px solid #000; padding: 8px;">{!rca.Correction__c}</td>
                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                </div>
            </apex:outputPanel>
            
            <!-- P01 Specific: Ink and Make-Up Details -->
            <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P01'}">
                <div style="page-break-inside:avoid;">
                    <table class="table-container" style="width: 100%; border-collapse: collapse; margin: 20px 0; margin-top: 5px; font-size: 12px; border: 1px solid #000;">
                        <thead class="label" style="border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ink Part NO</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ink Customer stock</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ink EXP DATE</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Make Up Customer stock</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Ink_Part_No__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Ink_Customer_Stock__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">
                                    <apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISNULL(record.Ink_Exp_Date__c))}">
                                        <apex:param value="{!record.Ink_Exp_Date__c}"/>
                                    </apex:outputText>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.MakeUp_Customer_Stock__c}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Make Up Part Details -->
                <div style="page-break-inside:avoid;">
                    <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 20px 0; margin-top:20px;font-size: 12px;">
                        <tr>
                            <th style="border: 1px solid black;padding: 8px;text-align: center;">Make up Part No</th>
                            <th style="border: 1px solid black;padding: 8px;text-align: center;">Make Up EXP Date</th>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black;padding: 8px;text-align: left;">{!record.MakeUp_Part_No__c}</td>
                            <td style="border: 1px solid black;padding: 8px;text-align: left;">
                                <apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISNULL(record.Make_Up_Exp_Date__c))}">
                                    <apex:param value="{!record.Make_Up_Exp_Date__c}"/>
                                </apex:outputText>
                            </td>
                        </tr>
                    </table>
                </div>
                <div style="page-break-inside:avoid;">
                    <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 5px 0; font-size: 12px;">
                        <tr>
                            <td class="label" style="border: 1px solid #000;padding: 8px;width:20%;"><b>Product Counter</b></td>
                            <td style="border: 1px solid #000;padding: 8px;" colspan="5">{!record.Product_Counter__c}</td>
                        </tr>
                    </table>
                </div>
                
                <!-- Machine Parameters Table -->
                <div style="page-break-inside:avoid;">
                    <table class="table-container" style="width: 100%; border-collapse: collapse; margin: 20px 0; margin-top: 5px; font-size: 12px; border: 1px solid #000;">
                        <thead class="label" style="border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Visc Set Point.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Visc Actual.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ink Temp.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Cabinet Temp.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Head Temp</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ink Pressure</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Visc_Set_Point__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Visc_Actual__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Ink_Temp__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Cabinet_Temp__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Head_Temp__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Ink_Pressure__c}</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Heater Point</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Modulation.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Charge Value.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">EHT Range Min.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">EHT Range Max.</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">EHT Grade</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Gutter Mode</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Heater_Point__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Modulation__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Charge_Value__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.EHT_Range_Min__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.EHT_Range_Max__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.EHT_Grade__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Gutter_Mode__c}</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Charge Value</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Print Quality</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Print Head Set</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ink type</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">VMC Calibration - Auto/Manual</td>
                                <td style="border: 1px solid #000; padding: 8px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Charge_Value__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Print_Quality__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Print_Head_Set__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.Ink_Type__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;">{!record.VMC_Calibration__c}</td>
                                <td style="border: 1px solid #000; padding: 8px;"></td>
                            </tr>
                        </thead>
                    </table>
                </div>
            </apex:outputPanel>
            
            <!-- P03 Specific: Parameter Settings Table -->
            <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P03'}">
                <div style="page-break-inside:avoid;">
                    <table class="table-container" style="width: 100%; border-collapse: collapse; margin: 20px 0; margin-top: 5px; font-size: 12px; border: 1px solid #000;">
                        <thead class="label" style="border: 1px solid #000;">
                            <tr>
                                <th style="border: 1px solid #000; padding: 8px; font-weight: bold; text-align: center;">Parameter</th>
                                <th style="border: 1px solid #000; padding: 8px; font-weight: bold; text-align: center;">Option</th>
                                <th style="border: 1px solid #000; padding: 8px; font-weight: bold; text-align: center;">Type</th>
                                <th style="border: 1px solid #000; padding: 8px; font-weight: bold; text-align: center;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <apex:repeat value="{!serviceReportParameters}" var="param">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!param.Name}</td>
                                    <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!param.Selection_Options_List__c}</td>
                                    <td style="border: 1px solid #000; padding: 8px; text-align: left;">{!param.Selected_Type__c}</td>
                                    <td style="border: 1px solid #000; padding: 8px; text-align: left;">
                                        <apex:outputText value="N/A" rendered="{!OR(ISBLANK(param.Selection_Value__c), param.Selection_Value__c == 'N/A', param.Selection_Value__c == 'NA')}"/>
                                        <apex:outputText value="{!param.Selection_Value__c}" rendered="{!AND(NOT(ISBLANK(param.Selection_Value__c)), param.Selection_Value__c != 'N/A', param.Selection_Value__c != 'NA')}"/>
                                    </td>
                                </tr>
                            </apex:repeat>
                            <apex:outputPanel rendered="{!serviceReportParameters.size == 0}">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 8px;"></td>
                                    <td style="border: 1px solid #000; padding: 8px;"></td>
                                    <td style="border: 1px solid #000; padding: 8px;"></td>
                                    <td style="border: 1px solid #000; padding: 8px;"></td>
                                </tr>
                            </apex:outputPanel>
                        </tbody>
                    </table>
                </div>
            </apex:outputPanel>
            
            <!-- P02 (TTO) Specific: Model Details and Ribbon Information -->
            <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c == 'P02'}">
                <!-- Ribbon Part Details -->
                <div style="page-break-inside:avoid;">
                    <table class="table-container" style="width: 100%; border-collapse: collapse; margin: 20px 0; margin-top: 5px; font-size: 12px; border: 1px solid #000;">
                        <thead class="label" style="border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ribbon Part #</td>
                                <td style="border: 1px solid #000; padding: 8px; font-weight: bold;">Ribbon Customer Stock</td>
