                    </tr>
                </table>
                </div>
            </apex:outputPanel>

            <!-- TTO specific header - matching sheet layout -->
            <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c = 'P02'}">
                <!-- Basic Information and Printer Details -->
                <div class="section-container">
