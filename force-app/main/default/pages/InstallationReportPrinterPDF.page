<apex:page standardStylesheets="false" renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false" docType="html-5.0" controller="InstallationReportPdfController">

    <!-- Printer Installation Report – based on existing InstallationReportPDF layout -->

    <head>
        <style type="text/css" media="print">
            @page {
                padding-top: 60px;
                margin-bottom:70px;
                @top-center {
                    content: element(header);
                }
                @bottom-right {
                    content: element(footer);
                }
            }
            div.header {
                padding: 10px;
                display: block;
                position: running(header);
            }
            div.footer {
                width: 98%;
                padding: 5px;
                display: block;
                text-align: right;
                position: running(footer);
            }
            .pagenumber:before {
                content: counter(page);
            }
            .pagecount:before {
                content: counter(pages);
            }

            body {
                padding-top: 20px;
                /* Align base font with Service Report PDF */
                font-size: 12px;
            }

            .pdf-table-input{
                width: 100%;
                border: 1px solid #000;
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
            }
            .table-container {
                width: 100%;
                border-collapse: collapse;
                margin: 5px 0;
                /* Match Service Report table font size */
                font-size: 12px;
                /* Prevent table from breaking across pages */
                page-break-inside: avoid;
                break-inside: avoid;
            }
            .table-container td {
                border: 1px solid #000;
                padding: 8px;
            }
            /* Prevent table rows from breaking */
            .table-container tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }
            .table-container td.label {
                font-weight: bold;
                /* Left-align labels like Service Report */
                text-align: left;
            }
            /* General styling for text alignment and table borders */
            .main-table {
                width: 100%;
                border-collapse: collapse;
                margin: 20px 0;
                /* Slightly smaller for dense parameter tables, as in Service Report */
                font-size: 9px;
                /* Prevent table from breaking across pages */
                page-break-inside: avoid;
                break-inside: avoid;
            }
            .main-table td {
                border: 1px solid #000;
                padding: 8px;
                text-align: left;
            }
            /* Prevent table rows from breaking */
            .main-table tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }
            .maintenance-schedule {
                text-align: center;
                font-weight: bold;
                margin-top: 10px;
            }
            .schedule-table {
                width: 100%;
                border-collapse: collapse;
                margin: 10px 0;
            }
            .schedule-table td {
                border: 1px solid #000;
                padding: 5px;
                text-align: center;
            }
            .signature-section {
                display: flex;
                justify-content: space-between;
                margin-top: 20px;
            }
            .signature-box {
                width: 48%;
                border: 1px solid black;
                padding: 10px;
                text-align: left;
            }
            .signature-title {
                font-weight: bold;
                margin-bottom: 10px;
            }
            .report-table{
                width: 100%;
                border-collapse: collapse;
                border-spacing: 0;
                -fs-table-paginate: paginate;
            }

            /* Long text wrapping similar to Service Report (for remarks etc.) */
            .wrap-text {
                white-space: pre-wrap;
                word-wrap: break-word;
                overflow-wrap: break-word;
                word-break: break-word;
                line-height: 1.3;
                font-size: 11px;
                text-align: left;
            }

            .header-cell {
                text-align: left;
                font-weight: bold;
                padding: 3px 5px;
                margin-top: 9px !important;
            }

            /* Section containers to prevent page breaks */
            .section-container {
                page-break-inside: avoid;
                break-inside: avoid;
                margin-bottom: 10px;
                orphans: 3;
                widows: 3;
            }

            /* Photo section specific styling */
            .photo-section {
                page-break-inside: avoid;
                break-inside: avoid;
                orphans: 2;
                widows: 2;
            }

            ol li {
                padding: 8px 0px 8px 0px;
            }
            ol li ol li {
                padding: 4px 0px 4px 0px;
            }
        </style>
    </head>

    <body>

        <!-- <apex:outputPanel rendered="{!isPreview}">
            <img src="{!URLFOR($Resource.Watermark)}" width="100%" height="100%" style="position: fixed;background-repeat:repeat;left: 0cm; top:0cm; z-index:0" />
        </apex:outputPanel> -->

        <div class="header">
            <table style=" width:100%;border:none;margin-top:10px; border-collapse: collapse; ">
                <tr>
                    <td style="padding-left:90px;border-collapse:collapse;text-align:center;">
                        <strong style="width:100%; font-size:15px; font-family:Times New Roman;"><i>Nilkamal Limited</i></strong>
                        <strong>
                            <p style="margin:0px;font-size:10px;">SERVICE DIVISION</p>
                        </strong>
                    </td>
                    <td style="padding:5px 5px;font-size:16px;border-collapse: collapse;width:10%;">
                        <img style="width:100px;height:50px" alt="logo" src="{!$Resource.NilkamalLogo}"/>
                    </td>
                </tr>
                <h6 style="font-family : Microsoft Sans Serif; text-align:center; font-size: 10px;margin:0px;padding:0px;">Regd. / Administrative Office : Nilkamal Houce, Plot No. 77/78, Street No.14, M.I.D.C., Andheri (E) , Mumbai - 93.
                    <br/>Tel: (022) 4235 8825 Mobile : 80077 73280 Fax : 98230 38284 E-mail : mhe.services@nilkamal.com
                </h6>
            </table>
        </div>

        <div class="footer">
            <div>Page <span class="pagenumber"/> of <span class="pagecount"/></div>
        </div>

        <div class="content">

            <!-- Header: Sr. No / Commissioning Report / Date -->
            <table style="width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; font-size: 12px;">
                <tr>
                    <td style="text-align: left; width: 33%; border: 1px solid #000; padding: 6px;">
                        <b>Sr. No.</b> {!record.Name}
                    </td>
                    <td style="text-align: center; width: 34%; border: 1px solid #000; padding: 6px;">
                        <b>INSTALLATION REPORT</b>
                    </td>
                    <td style="text-align: right; width: 33%; border: 1px solid #000; padding: 6px;">
                        <b>Date:</b>
                        <apex:outputText value="{0, date, dd/MM/yyyy}">
                            <apex:param value="{!today}" />
                        </apex:outputText>
                    </td>
                </tr>
            </table>

            <!-- Customer / Header block - CIJ only -->
            <apex:outputPanel rendered="{!record.Case__r.Asset.Product2.Material_Group_5__c = 'P01'}">
                <div class="section-container">
                <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 5px 0;font-size: 12px;">
                    <tr>
                        <td class="label" style="padding: 6px;">Customer Name</td>
                        <td colspan="3" style="padding: 6px;">{!IF(ISBLANK(record.Customer_Name__c), record.Case__r.Account.Name, record.Customer_Name__c)}</td>
                        <td class="label" style="padding: 6px;">Party Code</td>
                        <td style="padding: 6px;">{!IF(ISBLANK(record.Party_Code__c), record.Case__r.Account.SAP_Customer_code__c, record.Party_Code__c)}</td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Contact Person Name &amp; No</td>
                        <td colspan="2" style="padding: 6px;">{!record.Case__r.Contact.Name}</td>
                        <td colspan="3" style="padding: 6px;">{!record.Case__r.ContactMobile}</td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Location</td>
                        <td colspan="5" style="padding: 6px;">{!record.Location__c}</td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Printer Model</td>
                        <td colspan="2" style="padding: 6px;">{!record.Printer_Model__c}</td>
                        <td class="label" style="padding: 6px;">Printer Sr. No.</td>
                        <td colspan="2" style="padding: 6px;">{!record.Printer_Serial_Number__c}</td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Ink Part No</td>
                        <td colspan="2" style="padding: 6px;">{!record.Ink_Part_No__c}</td>
                        <td class="label" style="padding: 6px;">Ink EXP Date</td>
                        <td colspan="2" style="padding: 6px;">
                            <apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISNULL(record.Ink_Exp_Date__c))}">
                                <apex:param value="{!record.Ink_Exp_Date__c}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Make up Part No</td>
                        <td colspan="2" style="padding: 6px;">{!record.Make_Up_Part_No__c}</td>
                        <td class="label" style="padding: 6px;">Make EXP Date</td>
                        <td colspan="2" style="padding: 6px;">
                            <apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISNULL(record.Make_Up_Exp_Date__c))}">
                                <apex:param value="{!record.Make_Up_Exp_Date__c}"/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Software No</td>
                        <td colspan="2" style="padding: 6px;">{!record.Software_No__c}</td>
                        <td class="label" style="padding: 6px;">Nozzle Sr. No</td>
                        <td colspan="2" style="padding: 6px;">{!record.Nozzle_Serial_No__c}</td>
                    </tr>
                </table>
                </div>
            </apex:outputPanel>

            <!-- TIJ specific header - matching sheet layout -->
