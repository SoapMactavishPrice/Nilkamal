                                        <br/>
                                        <span style="font-size: 10px; word-wrap: break-word;">{!imgWrapper.title}</span>
                                    </div>
                                </apex:repeat>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!printingMessageImages.size == 0}">
                                <div style="padding: 20px; height: 80px;"></div>
                            </apex:outputPanel>
