                </div>
                
                <!-- Common Contact Information -->
                <h3 style="text-align: center; font-size: 12px; margin: 20px 0;">
                    E-mail : 
                    <a href="mailto:printer.service1@nilkamal.com" style="color: #0000EE; text-decoration: none;">
                        printer.service1@nilkamal.com
                    </a>
                    <span style="margin: 0 10px;">Toll Free No:</span>
                    <a href="tel:18008909115" style="color: #0000EE; text-decoration: none;">
                        1800 890 9115
                    </a>
                </h3>
                
                <!-- Customer Comments -->
                <div class="section-container">
                <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 5px 0;font-size: 12px;">
