                <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 5px 0;font-size: 12px;">
                    <tr>
                        <td class="label" style="padding: 6px; width: 16.66%;">Industry Type:</td>
                        <td style="padding: 6px; width: 16.66%;">{!record.Industry_Type__c}</td>
                        <td class="label" style="padding: 6px; width: 16.66%;">Substrate Type:</td>
                        <td style="padding: 6px; width: 16.66%;">{!record.Substrate_Type__c}</td>
                        <td class="label" style="padding: 6px; width: 16.66%;">Customer Product Name</td>
                        <td style="padding: 6px; width: 16.66%;">{!record.Customer_Product_Name__c}</td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Line Speed meter per/Min</td>
                        <td style="padding: 6px;">{!record.Line_Speed_meter_per_Min__c}</td>
                        <td class="label" style="padding: 6px;">Customer Requirement</td>
                        <td style="padding: 6px;"></td>
                        <td colspan="2"></td>
                    </tr>
                    <tr>
                        <td class="label" style="padding: 6px;">Work Load</td>
                        <td style="padding: 6px;">{!record.Work_Load_Hrs_Day__c} Hrs Per Day</td>
                        <td style="padding: 6px;">{!record.Work_Load_Days_Wk__c} Days Per Week</td>
                        <td class="label" style="padding: 6px;">Shift</td>
                        <td style="padding: 6px;">{!record.Shift__c}</td>
                        <td></td>
                    </tr>
                </table>
                </div>
                
                <!-- TIJ Parameter Settings - Full Table Format -->
                <div class="section-container">
                <table class="table-container" style="width: 100%;border-collapse: collapse;margin: 5px 0;font-size: 11px;">
                    <thead>
                        <tr>
                            <td class="label" style="padding: 6px; font-weight: bold; text-align: center; border: 1px solid #000;">Parameter</td>
                            <td class="label" style="padding: 6px; font-weight: bold; text-align: center; border: 1px solid #000;">Selection Options list</td>
                            <td class="label" style="padding: 6px; font-weight: bold; text-align: center; border: 1px solid #000;">If Selected type</td>
                            <td class="label" style="padding: 6px; font-weight: bold; text-align: center; border: 1px solid #000;">Selection Value</td>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat value="{!installationReportParameters}" var="param">
