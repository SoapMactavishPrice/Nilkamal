                                <td style="padding: 6px; border: 1px solid #000;"></td>
                                <td style="padding: 6px; border: 1px solid #000;"></td>
                                <td style="padding: 6px; border: 1px solid #000;"></td>
                                <td style="padding: 6px; border: 1px solid #000;"></td>
                            </tr>
                        </apex:outputPanel>
                    </tbody>
                </table>
                </div>
                
                <!-- Photo Sections for TIJ -->
