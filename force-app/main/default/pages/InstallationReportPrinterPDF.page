                        <td class="label" style="padding: 6px; text-align: center; width: 33.33%;">Photo 01 print head direction Photo</td>
                        <td class="label" style="padding: 6px; text-align: center; width: 33.33%;">Photo 2 Printing message Photo / Quality</td>
