<apex:page standardStylesheets="false" renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false" docType="html-5.0" controller="InstallationReportPdfController">

    <!-- <apex:stylesheet value="{!$Resource.ServiceReportFooter}" /> -->
    <!-- <c:PDFHeaderFooter type="footer" position="right" showPageNumbers="true" /> -->


    <head>
        <style type="text/css" media="print">
            @page {
                padding-top: 60px;
                margin-bottom:70px;
                @top-center {
                    content: element(header);
                }
                @bottom-right {
                    content: element(footer);
                }
            }
            div.header {
                padding: 10px;
                display: block;
                position: running(header);
            }
            div.footer {
                width: 98%;
                padding: 5px;
                display: block;
                text-align: right;
                position: running(footer);
            }
            .pagenumber:before {
                content: counter(page);
            }
            .pagecount:before {
                content: counter(pages);
            }

            body {
                padding-top: 20px;
            }


            .pdf-table-input{
            width: 100%;
            border: 1px solid #000;
            border-top: 1px solid #000;
            border-bottom: 1px solid #000;
            }
            .table-container {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 14px;
            }
            .table-container td {
            border: 1px solid #000;
            padding: 8px;
            }
            .table-container td.label {
            font-weight: bold;
            text-align: right;
            }
            /* General styling for text alignment and table borders */
            .main-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 12px;
            }
            .main-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: center;
            }
            .maintenance-schedule {
            text-align: center;
            font-weight: bold;
            margin-top: 10px;
            }
            .schedule-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            }
            .schedule-table td {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            }
            .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            }
            .signature-box {
            width: 48%;
            border: 1px solid black;
            padding: 10px;
            text-align: left;
            }
            .signature-title {
            font-weight: bold;
            margin-bottom: 10px;
            }
            .report-table{
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            -fs-table-paginate: paginate;
            }

            ol li {
                padding: 8px 0px 8px 0px;
            }
            ol li ol li {
                padding: 4px 0px 4px 0px;
            }
        </style>
    </head>



    <body>

        <apex:outputPanel rendered="{!isPreview}">
            <img src="{!URLFOR($Resource.Watermark)}" width="100%" height="100%" style="position: fixed;background-repeat:repeat;left: 0cm; top:0cm; z-index:0" />
        </apex:outputPanel>

        <div class="header">
            <table style=" width:100%;border:none;margin-top:10px; border-collapse: collapse; ">
                <tr>
                    <td style="padding-left:90px;border-collapse:collapse;text-align:center;">
                        <strong style="width:100%; font-size:15px; font-family:Times New Roman;"><i>Nilkamal Limited</i></strong>
                        <strong>
                            <p style="margin:0px;font-size:10px;">SERVICE DIVISION</p>
                        </strong>
                    </td>
                    <td style="padding:5px 5px;font-size:16px;border-collapse: collapse;width:10%;">
                        <img style="width:100px;height:50px" alt="logo" src="{!$Resource.NilkamalLogo}"/>
                    </td>
                </tr>
                <h6 style="font-family : Microsoft Sans Serif; text-align:center; font-size: 10px;margin:0px;padding:0px;">Regd. / Administrative Office : Nilkamal Houce, Plot No. 77/78, Street No.14, M.I.D.C., Andheri (E) , Mumbai - 93.
                    <br/>Tel: (022) 4235 8825 Mobile : 80077 73280 Fax : 98230 38284 E-mail : mhe.services@nilkamal.com
                </h6>
            </table>
        </div>

        <div class="footer">
            <div>Page <span class="pagenumber"/> of <span class="pagecount"/></div>
        </div>



        <div class="content">

            <table style="width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px">
                <tr>
                    <td style="text-align: left; width: 33%; font-size: 12px;">No. {!record.Name}</td>
                    <td style="text-align: center; width: 33%; font-size: 14px;">COMMISSIONING REPORT</td>
                    <td style="text-align: right; width: 33%; font-size: 12px;">
                        Date :
                        <apex:outputText value="{0, date, dd/MM/yyyy}">
                            <apex:param value="{!today}" />
                        </apex:outputText>
                    </td>
                </tr>
            </table>

            <table class="table-container" style=" width: 100%;border-collapse: collapse;margin: 20px 0; margin-top:5px;font-size: 12px;">
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">Customer :</td>
                    <td colspan="3" style="border: 1px solid #000;padding: 8px;">{!record.Case__r.Account.Name}</td>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">Party Code :</td>
                    <td style="border: 1px solid #000;padding: 8px;">{!record.Case__r.Account.SAP_Customer_code__c}</td>
                </tr>
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">Contact Person :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px;">{!record.Case__r.Contact.Name}</td>
                    <td class="label" style="border: 1px solid #000;padding: 8px">Contact No. :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px">{!record.Case__r.ContactMobile}</td>
                </tr>
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">OEM Model No. :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px;">{!record.Case__r.Asset.Product2.OEM_Material_Code__c}</td>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">OEM Sr. No. :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px;">{!record.Case__r.Asset.OEM_Serial_Number__c}</td>
                </tr>
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">Model No. :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px">{!record.Item_Master__r.ProductCode}</td>
                    <td class="label" style="border: 1px solid #000;padding: 8px">NKL Sr. No. :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px">{!record.Case__r.Asset.SerialNumber}</td>
                    <!--
                    <td class="label"  style="border: 1px solid #000;padding: 8px;">HMR :</td>
                    <td style="border: 1px solid #000;padding: 8px"></td>
                    -->
                </tr>
                <tr>
                    <td class="label" style="border: 1px solid #000;padding: 8px; ">Product :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px;">{!record.Item_Master__r.Name}</td>
                    <td class="label" style="border: 1px solid #000;padding: 8px;">Invoice No. &nbsp; Date :</td>
                    <td colspan="2" style="border: 1px solid #000;padding: 8px;">
                        {!record.Case__r.Asset.Invoice_Number__c} - &nbsp;
                        <apex:outputText value="{0,date,dd MMM yyyy}">
                            <apex:param value="{!record.Case__r.Asset.Invoice__r.Billing_Date__c}" />
                        </apex:outputText>
                    </td>
                </tr>
            </table>


            <div>
                <div style="width: 48%; border-collapse: collapse; float: left; font-size: 12px; margin-top: 5px">
                    <apex:repeat value="{!col1}" var="categoryList">
                        <table class="report-table" style="border-collapse: collapse;width: 100%;-fs-table-paginate: paginate; border-spacing: 0;">
                            <thead style="border-collapse: collapse;border-spacing: 0;">
                                <tr>
                                    <th colspan="2">
                                        <div class="section-title" style="font-weight: bold; margin-bottom:5px;">{!categoryList[0].Checklist_Category__c}:</div>
                                    </th>
                                </tr>
                                <tr style="border-collapse: collapse;">
                                    <th style="border: 0.5px solid black;padding: 4px;text-align: left;border-collapse: collapse;border-spacing: 0;width:80%;">Check Point</th>
                                    <th style="border: 0.5px solid black;padding: 4px;text-align: left;border-collapse: collapse;border-spacing: 0;width:20%;">Observation</th>
                                </tr>
                            </thead>
                            <apex:repeat value="{!categoryList}" var="checklist">
                                <tbody style="border-collapse: collapse;border-spacing: 0;">
                                    <tr style="page-break-inside: avoid;border-collapse: collapse;border-spacing: 0;">
                                        <td style="border: 0.5px solid black;padding: 8px;text-align: left;border-collapse: collapse;border-spacing: 0;width:80%;">{!checklist.Check_Point__c}</td>
                                        <td style="border: 0.5px solid black;padding: 8px;text-align: left;border-collapse: collapse;border-spacing: 0;width:20%;">{!checklist.Observation__c}</td>
                                    </tr>
                                </tbody>
                            </apex:repeat>
                        </table>
                    </apex:repeat>
                </div>

                <div style="width: 48%; border-collapse: collapse; float: right; font-size: 12px; margin-top: 5px">
                    <apex:repeat value="{!col2}" var="categoryList">
                        <table class="report-table" style="border-collapse: collapse;width: 100%;-fs-table-paginate: paginate; border-spacing: 0;">
                            <thead style="border-collapse: collapse;border-spacing: 0;">
                                <tr>
                                    <th colspan="2">
                                        <div class="section-title" style="font-weight: bold; margin-bottom:5px;">{!categoryList[0].Checklist_Category__c}:</div>
                                    </th>
                                </tr>
                                <tr style="border-collapse: collapse;">
                                    <th style="border: 0.5px solid black;padding: 4px;text-align: left;border-collapse: collapse;border-spacing: 0;width:80%;">Check Point</th>
                                    <th style="border: 0.5px solid black;padding: 4px;text-align: left;border-collapse: collapse;border-spacing: 0;width:20%;">Observation</th>
                                </tr>
                            </thead>
                            <apex:repeat value="{!categoryList}" var="checklist">
                                <tbody style="border-collapse: collapse;border-spacing: 0;">
                                    <tr style="page-break-inside: avoid;border-collapse: collapse;border-spacing: 0;">
                                        <td style="border: 0.5px solid black;padding: 8px;text-align: left;border-collapse: collapse;border-spacing: 0;width:80%;">{!checklist.Check_Point__c}</td>
                                        <td style="border: 0.5px solid black;padding: 8px;text-align: left;border-collapse: collapse;border-spacing: 0;width:20%;">{!checklist.Observation__c}</td>
                                    </tr>
                                </tbody>
                            </apex:repeat>
                        </table>
                    </apex:repeat>
                </div>
            </div>

            <br/>
            <br/>


            <div style="clear: both">
                <div style="text-align: justify; font-size: 12px; margin-top: 20px; page-break-inside: avoid">
                    <div style="text-align: center; font-size: 16px"><strong><u>STANDARD WARRANTY POLICY</u></strong></div>
                    <ol>
                        <li><strong>WARRANTY PERIOD &amp; ACTIVATION:</strong> Material Handling Equipments manufactured or imparted by NILKAMAL Ltd is warranted to be free from defects in material and workmanship under normal use and service, provided it is still owned and operated by the original purchaser, for the period as mentioned below:
                            <ol>
                                <li><strong>For equipments which have hour meters-Electric Stackers/Battery Operated Pallet truck's / Reach trucks/Forklifts</strong>: Standard warranty of twelve months or 2000 (two thousand) hours whichever is earlier for manufacturing defects only. The warranty period start from the date of commissioning or fifteen days from the date of invoice, whichever is earlier, subject to our standard warranty policy.</li>
                                <li><strong>For equipments which do not have hour meters - Aerial work platforms / Manual range-excluding Pallet Trucks:</strong> Standard warranty of twelve months for manufacturing defects only. The warranty period start from the date of commissioning or fifteen days from the date of invoice, whichever is earlier, subject to our standard warranty policy.</li>
                                <li><strong>For pallet trucks</strong>: Standard warranty of six months for manufacturing defects only. The warranty period start from fifteen days from the date of invoice.</li>
                            </ol>
                        </li>
                        <li><strong>WARRANTY INCLUSION:</strong> During the warranty period as specified above NILKAMAL LTD. will replace/repair the component within reasonable time which is having manufacturing defect, at NILKAMAL's sole discretion.</li>
