                        <li><strong>GOVERNING LAW:</strong> Any dispute arising out of this contract shall be governed by the court having jurisdiction only at Silvassa &amp; Mumbai.</li>
                    </ol>
                </div>
            </div>



            <div style="page-break-inside: avoid; margin-top: 20px">
                <table style="width: 100%; border-collapse: collapse; font-size: 12px; clear: both">
                    <tbody>
                        <tr style="border-collapse: collapse; border: 1px solid #000">
                            <td colspan="2" class="label" style="border: 1px solid #000;padding: 8px; text-align:center;">
                                Equipment Commissioned, Necessary Training Pertaining Safety, Operation and Maintenance is given to Customer.
                                Please Refer Operation and Maintenance Manual For Better Operational Efficiency and Safety.
                                Procure recommended spare parts for schedule maintenance. For Standard Warranty Policy please read overleaf.
                            </td>
                        </tr>
                        <tr style="border-collapse: collapse; border: 1px solid #000">
                            <td colspan="2" class="label" style="border: 1px solid #000;padding: 8px; text-align:center; width:100%">
                                E-mail : mhe.services@nilkamal.com / Toll Free No.: 8007773280
                            </td>
                        </tr>
                        <tr style="border-collapse: collapse; border: 1px solid #000">
                            <td style="border: 1px solid #000;padding: 8px; height:25px;vertical-align:baseline;">
                                <!-- <p style="text-align:left;">Customer Contact Name : {!record.Signature_by__c}</p>
                                <p style="text-align:left;">Customer Email : {!record.Customer_Email__c}</p>
                                <p style="text-align:left;">Customer Contact No. :{!record.Customer_Contact_Number__c}</p>
                                <p style="text-align:left;">Customer Sign and Seal</p><br/>
                                <apex:outputText value="{!record.Signature__c}" escape="false"/> -->
                                <div style="line-height: 1; margin: 0; padding: 0;">
                                <p style="text-align:center; margin-top: 5px; padding: 2px;">Customer's Acceptance</p>
                                <p style="text-align:left; margin: 0; padding: 2px;">Name : {!record.Signature_by__c}</p>
                                <p style="text-align:left; margin: 0; padding: 2px;">Designation : {!record.Customer_Designation__c}</p>
                                <p style="text-align:left; margin: 0; padding: 2px;">Mobile No : {!record.Customer_Contact_Number__c}</p>
                                <p style="text-align:left; margin: 0; padding: 2px;">Email : {!record.Customer_Email__c}</p>
                                <p style="text-align:left; margin: 0; padding: 2px;">Sign :</p>
                                <apex:outputText value="{!record.Signature__c}" escape="false" />
                                </div>
                            </td>
                            <!-- <td style="border: 1px solid #000;padding: 8px; width:50%; height:50px;">
                                Service Engineer<br/><br/>
                                <apex:outputText value="{!serviceResource.Signature__c}" escape="false" />
                                <br/>Sign
                            </td> -->
                        </tr>
                    </tbody>
                </table>
            </div>



            <div style="page-break-inside:avoid; padding-top:20px">

                Yours faithfully,
                <br/>
                <strong>NILKAMAL LIMITED</strong>
                <br/>
                <br/>

                <table style="width:100%; border-collapse:collapse; font-size:14px; text-align:left;">
                    <tr>
                        <td style="border:1px solid #000; padding:8px;">
                            <br/>
                            <strong>{!record.Case__r.Owner.Name}</strong>
                            <br/> {!record.Case__r.Division__c} - SERVICE DIVISION
                            <br/>
                            <a href="mailto:{!record.Case__r.Owner.Email}" style="color:blue; text-decoration:none;">{!record.Case__r.Owner.Email}</a>
                            <br/> {!record.Case__r.Owner.Phone}

                        </td>
                        <td style="border:1px solid #000; padding:8px;">
                            <br/>
                            <strong>{!serviceResource.RSM__r.Name}</strong>
                            <br/> Regional Service Manager
                            <br/>
                            <a href="mailto:{!serviceResource.RSM__r.Email}" style="color:blue; text-decoration:none;">{!serviceResource.RSM__r.Email}</a>
                            <br/> {!serviceResource.RSM__r.MobilePhone}
                        </td>
                        <td style="border:1px solid #000; padding:8px;">
                            <br/>
                            <strong>{!serviceResource.Coordinator__r.Name}</strong>
                            <br/> Service Coordinator
                            <br/>
                            <a href="mailto:{!serviceResource.Coordinator__r.Email}" style="color:blue; text-decoration:none;">{!serviceResource.Coordinator__r.Email}</a>
                            <br/> {!serviceResource.Coordinator__r.MobilePhone}
                        </td>
                    </tr>
                </table>
            </div>
        </div>

    </body>

</apex:page>