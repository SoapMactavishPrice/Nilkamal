global class FetchPendingOrderQueuable implements Queueable, Database.AllowsCallouts {
    
    Integer offset;
    public FetchPendingOrderQueuable(Integer offset) {
        this.offset = offset;
    }
    
    
    public void execute(QueueableContext context) {
        API_log__c apiLog=new API_log__c();
        apiLog.Log_Name__c ='PendingOrderAPI';
        try{
            HttpUtils.APIparamter util=HttpUtils.getWSDLAPIdetails('PendingOrderAPI');
            
            String endpoint = util.Endpoint;
            String requestBody = '<?xml version="1.0" encoding="UTF-8"?>'
                + '<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:sap-com:document:sap:soap:functions:mc-style">'
                + '   <soapenv:Header/>'
                + '   <soapenv:Body>'
                + '      <urn:ZcrmSdPendOrder/>'
                + '   </soapenv:Body>'
                + '</soapenv:Envelope>';
            List<Map<String, String>> records = new List<Map<String, String>>();
            
            HttpRequest req = new HttpRequest();
            req.setEndpoint(endpoint);
            req.setMethod('POST');
            req.setHeader('Content-Type', 'text/xml; charset=UTF-8');
            req.setHeader('SOAPAction', 'urn:sap-com:document:sap:soap:functions:mc-style:ZcrmSdPendOrder');
            req.setBody(requestBody);
            req.setTimeout(120000);
            
            Http http = new Http();
            System.debug('===> '+JSON.serialize(req.getBody()));
            System.debug('===> '+req.getBody());
            
            HttpResponse res = http.send(req);
            System.debug('===> '+res.getBody());
            if(res.getStatusCode()==200){
                Dom.Document doc = new Dom.Document();
                doc.load(res.getBody());
                Dom.XMLNode root = doc.getRootElement();
                Dom.XMLNode body = root.getChildElement('Body', 'http://schemas.xmlsoap.org/soap/envelope/');
                Dom.XMLNode response = body.getChildElement('ZcrmSdPendOrderResponse', 'urn:sap-com:document:sap:soap:functions:mc-style');
                System.debug(response.getChildElement('EmPendOrder', null));
                Dom.XMLNode emPnding = response.getChildElement('EmPendOrder', null);
                System.debug(response.getChildElement('EmAddnData', null));
                String responseTotal=response.getChildElement('EmAddnData', null).getText();
                Integer total = responseTotal != null ? Integer.valueOf(responseTotal.trim()) : 0;
                System.debug('total '+total);
                
                Set<String> custids=new Set<String>();
                Set<String> mfgParts=new Set<String>();
                Set<String> slorgList=new Set<String>();
                Set<String> disChlList=new Set<String>();
                Set<String> bUomCodeList=new Set<String>();
                Set<String> pCodeList = new Set<String>();
                Set<String> divList = new Set<String>();
                Set<String> productCodes = new Set<String>();
                for (Dom.XMLNode item : emPnding.getChildElements()) {
                    for (Dom.XMLNode field : item.getChildElements()) {
                        String customer=item.getChildElement('Kunnr', null)?.getText();
                        if( customer!=null && customer!=''){
                            custids.add(customer);
                        }
                        String Mfrpn=item.getChildElement('Mfrpn', null).getText();
                        if(Mfrpn!=null && Mfrpn!=''){
                            mfgParts.add(Mfrpn);
                        }
                        String slorg=item.getChildElement('Vkorg', null)?.getText();
                        if(slorg!=null && slorg!=''){
                            slorgList.add(slorg);
                        }
                        
                        String disChl=item.getChildElement('Vtweg', null)?.getText();
                        if(disChl!=null && disChl!=''){
                            disChlList.add(disChl);
                        }
                        String div=item.getChildElement('Spart', null)?.getText();
                        if(div!=null && div!=''){
                            divList.add(div);
                        }
                        String Meins=item.getChildElement('Meins', null)?.getText();
                        if(Meins!=null && Meins!=''){
                            bUomCodeList.add(Meins);
                        }
                        
                        String Werks=item.getChildElement('Werks', null)?.getText();
                        if(Werks!=null && WERKS!=''){
                            pCodeList.add(WERKS);
                        }
                        
                        String Matnr=item.getChildElement('Matnr', null)?.getText();
                        if(Matnr!=null && Matnr!=''){
                            productCodes.add(Matnr);
                        }
                    }
                }
                Map<String, Account> accMap=new Map<String, Account>();
                for(Account ac:[Select id,Name,SAP_Customer_code__c from Account where SAP_Customer_code__c IN :custids]){
                    accMap.put(ac.SAP_Customer_code__c,ac);
                }
                
                Map<String,Manufacturing_Part_No__c> mfgMap=new Map<String,Manufacturing_Part_No__c>();
                for(Manufacturing_Part_No__c mfg:[
                        SELECT Id, Name 
                        FROM Manufacturing_Part_No__c 
                        WHERE Name IN :mfgParts
                    ]){
                    mfgMap.put(mfg.Name,mfg);
                }
                
                List<Sales_Organizations__c> soList= new List<Sales_Organizations__c>();
                soList = [SELECT ID,Name FROM Sales_Organizations__c WHERE Name IN : slorgList];
                
                Map<String,Sales_Organizations__c> soMap = new  Map<String,Sales_Organizations__c>();
                for (Sales_Organizations__c va : soList) {
                    
                    soMap.put(va.Name,va);
                }
                
                List<Distribution_Channel__c> dcList= new List<Distribution_Channel__c>();
                dcList = [SELECT ID,Distribution_Code__c  FROM Distribution_Channel__c WHERE Distribution_Code__c IN : disChlList];
                
                Map<String,Distribution_Channel__c> dcMap = new  Map<String,Distribution_Channel__c>();
                for (Distribution_Channel__c va : dcList) {
                    
                    dcMap.put(va.Distribution_Code__c,va);
                }
                
                List<Division__c> diList= new List<Division__c>();
                diList = [SELECT ID,Division_Code__c FROM Division__c WHERE Division_Code__c IN : divList];
                
                Map<String,Division__c> diMap = new  Map<String,Division__c>();
                for (Division__c va : diList) {
                    
                    diMap.put(va.Division_Code__c,va);
                }
                
                List<UOM_Master__c> baseList= new List<UOM_Master__c>();
                baseList = [SELECT ID,Code__c FROM UOM_Master__c WHERE Code__c IN : bUomCodeList];
                
                Map<String,UOM_Master__c> baseUomMap = new  Map<String,UOM_Master__c>();
                for (UOM_Master__c va : baseList) {
                    baseUomMap.put(va.Code__c,va);
                }
                
                Map<String, Plant_Master__c> plantMap = new Map<String, Plant_Master__c>();
                for (Plant_Master__c plant : [
                    SELECT Id, Plant_Code__c 
                    FROM Plant_Master__c 
                    WHERE Plant_Code__c IN :pCodeList
                ]) {
                    plantMap.put(plant.Plant_Code__c, plant);
                }
                
                // Product2 Map
                Map<String, Product2> productMap = new Map<String, Product2>();
                for (Product2 product : [
                    SELECT Id, ProductCode, Category__c, Business_Vertical__c 
                    FROM Product2 
                    WHERE ProductCode IN :productCodes
                ]) {
                    productMap.put(product.ProductCode, product);
                }
                
                List<User> ulist= new List<User>();
                ulist = [SELECT Id,UID__c,isActive from User];
                User adminUser = [SELECT Id FROM User WHERE Profile.Name = 'System Administrator' AND IsActive = true LIMIT 1];
                
                Map<String,String> uMap = new  Map<String,String>();
                Map<String,Boolean> uActiveMap = new Map<String,Boolean>();
                for (User va : ulist) {
                    
                    uMap.put(va.UID__c,va.Id);
                    uActiveMap.put(va.UID__c, va.IsActive);
                }
                
                List<Pending_Order__c> pendingList = new List<Pending_Order__c>();
                for (Dom.XMLNode item : emPnding.getChildElements()) {
                    Pending_Order__c po = new Pending_Order__c();
                    String customer= item.getChildElement('Kunnr', null)?.getText();
                    if(accMap.containsKey(customer)){
                        po.Customer_Name__c=accMap.get(customer).Id;
                    }
                    po.Sale_Order_Number__c =item.getChildElement('Vbeln', null)?.getText();
                    po.Name=item.getChildElement('Vbeln', null)?.getText();
                    po.Document_Date__c =item.getChildElement('Audat', null)?.getText()!='' && item.getChildElement('Audat', null)?.getText()!='0000-00-00'? Date.valueOf(item.getChildElement('Audat', null)?.getText()):null;
                    po.City__c = item.getChildElement('Ort01', null)?.getText();
                    po.Region__c = item.getChildElement('Regio', null)?.getText();
                    po.Customer_Purchase_Order_Number__c = item.getChildElement('Bstnk', null)?.getText()!=null && item.getChildElement('Bstnk', null)?.getText()!='' ?item.getChildElement('Bstnk', null)?.getText():'0';
                    po.Item_Number_of_the_SD_Document__c = item.getChildElement('Posnr', null)?.getText()!=null  && item.getChildElement('Posnr', null)?.getText()!=''?Decimal.valueOf(item.getChildElement('Posnr', null)?.getText()):0;
                    po.Material_Number__c =productMap.get(item.getChildElement('Matnr', null)?.getText())!=null?productMap.get(item.getChildElement('Matnr', null)?.getText()).Id:null;
                    po.Short_Text_for_Sales_Order_Item__c =  item.getChildElement('Arktx', null)?.getText();
                    po.Plant__c  =plantMap.get(item.getChildElement('Werks', null)?.getText())!=null?plantMap.get(item.getChildElement('Werks', null)?.getText()).Id:null;
                    po.Material_Group__c = item.getChildElement('Matkl', null)?.getText();
                    po.MG1_Description__c = item.getChildElement('Mvgr1', null)?.getText();
                    po.MG2_Description__c = item.getChildElement('Mvgr2', null)?.getText();
                    po.MG5_Description__c = item.getChildElement('Mvgr5', null)?.getText();
                    po.Cumulative_Order_Quantity_in_Sales_Units__c = item.getChildElement('Kwmeng', null)?.getText()!='' ?Decimal.valueOf (item.getChildElement('Kwmeng', null)?.getText()):0;
                    po.Delivery_Status__c = item.getChildElement('Lfsta', null)?.getText();
                    po.Actual_Quantity_Delivered_in_sales_unit__c   = item.getChildElement('Lfimg', null)?.getText() !='' ?Decimal.valueOf (item.getChildElement('Lfimg', null)?.getText()):0;
                    po.Actual_Quantity_Balance_in_sales_units__c = item.getChildElement('Balqty', null)?.getText() !='' ?Decimal.valueOf (item.getChildElement('Balqty', null)?.getText()):0;
                    po.Name_of_the_Controlling_Area__c  = item.getChildElement('Bezei', null)?.getText();
                    po.Sales_Employee__c = item.getChildElement('Salesman', null)?.getText();
                    po.Sales_Employee_Code__c = item.getChildElement('Sman', null)?.getText();
                    if(item.getChildElement('Sman', null)?.getText()!=''){
                        String uid=item.getChildElement('Sman', null)?.getText();
                        if(uMap.containsKey(uid)){
                            Boolean isActive = uActiveMap.get(uid);
                            if(isActive){
                                po.OwnerId=uMap.get(uid);
                            } else {
                                po.OwnerId = adminUser.Id;
                            }
                        }
                        else {
                            po.OwnerId = adminUser.Id;
                        }
                    }
                    
                    po.Sales_Group__c = item.getChildElement('Salesgrp', null)?.getText();
                    po.Sales_Office__c = item.getChildElement('Vkbur', null)?.getText();
                    po.Office_Decsription__c = item.getChildElement('SoText', null)?.getText();
                    po.Net_Weight__c = item.getChildElement('Ntgew', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Ntgew', null)?.getText()):0;
                    po.Gross_Weight__c = item.getChildElement('Brgew', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Brgew', null)?.getText()):0;
                    po.Net_Weight_of_the_Item__c = item.getChildElement('Ntgep', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Ntgep', null)?.getText()):0;
                    po.Sale_Price__c =  item.getChildElement('Price', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Price', null)?.getText()):0;
                    po.Price_List__c = item.getChildElement('Pricp', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Pricp', null)?.getText()):0;
                    po.Reason_Rejection_Quote_and_Sales_Order__c = item.getChildElement('Abgru', null)?.getText();
                    po.Sales_Document_Type__c = item.getChildElement('Auart', null)?.getText();
                    po.Document_Amount__c = item.getChildElement('Kzwi5', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Kzwi5', null)?.getText()):0;
                    po.Document_Number_of_Reference_Document__c = item.getChildElement('Vgbel', null)?.getText();
                    po.Customer_Number_of_Business_Partner__c = item.getChildElement('Kunn2', null)?.getText();
                    po.Customer_Address__c = item.getChildElement('Adrs', null)?.getText();
                    po.Manufacturer_Part_Number__c =mfgMap.get( item.getChildElement('Mfrpn', null)?.getText())!=null?mfgMap.get( item.getChildElement('Mfrpn', null)?.getText()).Id:null;
                    // po.Sales_Unit__c = item.getChildElement('Vrkme', null)?.getText() !=''? Decimal.valueOf(item.getChildElement('Vrkme', null)?.getText()):0;
                    //po.User_Name__c = item.getChildElement('Usnam', null)?.getText();
                    po.Del_No__c = item.getChildElement('Delno', null)?.getText();
                    po.PGI_No__c = item.getChildElement('Pgino', null)?.getText();
                    po.Inv_No__c = item.getChildElement('Invno', null)?.getText();
                    po.Usage_Indicator__c = item.getChildElement('Abrvw', null)?.getText();
                    po.Usage_Description__c = item.getChildElement('Usagedis', null)?.getText();
                    po.Schedule_Line_Date__c = item.getChildElement('Edatu', null)?.getText()!=''&& item.getChildElement('Edatu', null)?.getText()!='0000-00-00'? Date.valueOf(item.getChildElement('Edatu', null)?.getText()):null;
                    po.Item_Text__c = item.getChildElement('Itemtext', null)?.getText();
                    po.Item_Text1__c = item.getChildElement('Itemtext1', null)?.getText();
                    po.CHAR08__c = item.getChildElement('Holds', null)?.getText();
                    po.Sales_Organizations__c =soMap.get( item.getChildElement('Vkorg', null)?.getText())!=null?soMap.get( item.getChildElement('Vkorg', null)?.getText()).Id:null;
                    po.Distribution_Channel__c = dcMap.get(item.getChildElement('Vtweg', null)?.getText())!=null?dcMap.get(item.getChildElement('Vtweg', null)?.getText()).Id:null;
                    po.Division__c = diMap.get(item.getChildElement('Spart', null)?.getText())!=null?diMap.get(item.getChildElement('Spart', null)?.getText()).Id:null;
                    po.GO_Ahead_Date__c = item.getChildElement('Vsnmrv', null)?.getText();
                    po.PO_Received_Date__c	=item.getChildElement('Valdt', null)?.getText()!='' && item.getChildElement('Valdt', null)?.getText()!='0000-00-00'? Date.valueOf(item.getChildElement('Valdt', null)?.getText()):null;
                    po.Purchase_Order_Quantity__c = item.getChildElement('Labst', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Labst', null)?.getText()):0;
                    po.Stock_in_Transit__c = item.getChildElement('Trame', null)?.getText() !='' ?Decimal.valueOf(item.getChildElement('Trame', null)?.getText()):0;
                    po.Permanent_Account_Number__c  = item.getChildElement('J1ipanno', null)?.getText();
                    po.Customer_Approval_Date__c =item.getChildElement('Ihrez', null)?.getText()!=''? item.getChildElement('Ihrez', null)?.getText():null;
                    po.Name__c  = item.getChildElement('Desplant', null)?.getText();
                    po.Delivery_Block_document_header__c = item.getChildElement('Lifsk', null)?.getText();
                    po.Customer_Purchase_Order_Date__c = item.getChildElement('Bstdk', null)?.getText()!='' && item.getChildElement('Bstdk', null)?.getText()!='0000-00-00'?Date.valueOf(item.getChildElement('Bstdk', null)?.getText()):null;
                    po.Tax_Number_1__c	= item.getChildElement('Stcd1', null)?.getText();
                    po.Tax_Number_3__c = item.getChildElement('Stcd3', null)?.getText();
                    po.Tax_Number5__c = item.getChildElement('Stcd5', null)?.getText();
                    po.Control_Code_for_Consumption_taxes__c = item.getChildElement('Steuc', null)?.getText();
                    po.Condition_value__c = item.getChildElement('Tval', null)?.getText() !=''? Decimal.valueOf(item.getChildElement('Tval', null)?.getText()):0;
                    po.Comment__c = item.getChildElement('Coord', null)?.getText();
                    po.User_Field_for_Cluster_PC_national__c = item.getChildElement('Scrprint', null)?.getText();
                    po.Valuation_Class__c = item.getChildElement('Bklas', null)?.getText();
                    po.Description_of_Valuation_Class__c = item.getChildElement('Bkbez', null)?.getText();
                    po.Overall_Processing_Status_of_Document__c	= item.getChildElement('Gbstk', null)?.getText();
                    po.Sales_Category__c = item.getChildElement('Ordcat', null)?.getText();
                    po.Weight_Unit__c = item.getChildElement('Gewei', null)?.getText()!=''? Decimal.valueOf(item.getChildElement('Gewei', null)?.getText()):0;
                    po.Base_Unit_of_Measure__c = baseUomMap.get(item.getChildElement('Vrkme', null)?.getText())!=null?baseUomMap.get(item.getChildElement('Vrkme', null)?.getText()).Id:null ;
                    po.Valuated_Unrestricted_Use_Stock__c	= item.getChildElement('SplStk', null)?.getText()!=''?Decimal.valueOf(item.getChildElement('SplStk', null)?.getText()):0;
                    po.User_name_of_the_person_responsible__c = item.getChildElement('Cuname', null)?.getText();
                    po.Incoterms_Part_1__c = item.getChildElement('Inco1', null)?.getText();
                    po.Incoterms_Part_2__c = item.getChildElement('Inco2', null)?.getText();
                    po.Char_15__c = item.getChildElement('Status', null)?.getText();
                    po.Customer_group_1__c = item.getChildElement('Kvgr1', null)?.getText();
                    po.Customer_group_2__c = item.getChildElement('Kvgr2', null)?.getText();
                    po.Customer_group_3__c = item.getChildElement('Kvgr3', null)?.getText();
                    po.Customer_group_4__c = item.getChildElement('Kvgr4', null)?.getText();
                    po.Customer_group_5__c = item.getChildElement('Kvgr5', null)?.getText();
                    po.Installation_Commitment_Date__c =item.getChildElement('Zinstallation', null)?.getText()!='' && item.getChildElement('Zinstallation', null)?.getText()!='0000-00-00'? Date.valueOf(item.getChildElement('Zinstallation', null)?.getText()):null;
                    po.Installation_Start_Date__c =item.getChildElement('ZinstallationSta', null)?.getText()!='' && item.getChildElement('ZinstallationSta', null)?.getText()!='0000-00-00'? Date.valueOf(item.getChildElement('Zinstallation_sta', null)?.getText()):null;
                    po.Installation_End_Date__c = item.getChildElement('ZinstallationEnd', null)?.getText()!='' && item.getChildElement('ZinstallationEnd', null)?.getText()!='0000-00-00'?Date.valueOf(item.getChildElement('Zinstallation_end', null)?.getText()):null;
                    // po.Project_Completed_Installation_Report__c = item.getChildElement('Zprojekt_compl', null)?.getText();
                    po.Unique_Project_Number_Data_Element__c = item.getChildElement('Zunique_project_no', null)?.getText();
                    po.Plant__c =plantMap.get(item.getChildElement('Werks', null)?.getText())!=null?plantMap.get(item.getChildElement('Werks', null)?.getText()).Id:null;
                    po.Last_Released_Date__c = item.getChildElement('Lreldt', null)?.getText();
                    po.Reason_for_pending_order__c = item.getChildElement('RsnNo', null)?.getText();
                    po.Open_Stock_Qty__c = item.getChildElement('Stoqty', null)?.getText()!=''?Decimal.valueOf(item.getChildElement('Stoqty', null)?.getText()):0;
                    pendingList.add(po);
                    
                }
                if (!pendingList.isEmpty()) {
                    insert pendingList;
                }
                
                if (total > offset) {
                    System.enqueueJob(new FetchPendingOrderQueuable(offset + 1));
                }
                //apiLog.Response__c = res.getBody();
                apiLog.Status__c='Success';
            }
        }
        catch (Exception e) {
            System.debug('Error Parsing SOAP Response: ' + e.getMessage() + e.getLineNumber());
            apiLog.Exception_Description__c=e.getMessage() +' : '+e.getCause()+' : '+e.getStackTraceString();
            apiLog.Status__c='Failed';
        }
        Insert apiLog;
        
        
    }
    
    
    
