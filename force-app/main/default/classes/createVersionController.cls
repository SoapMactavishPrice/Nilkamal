public class createVersionController {

    @AuraEnabled
    public static string createQuoteAndRelated(String quoteId) {
        try {
            // Fetch existing Quote versions
            Boolean isValueChanged=false;
            String SoId=quoteId;
            String allFields = HttpUtils.getAllFields('Quote',SoId);
            List<Quote> quoteList = [
                SELECT Id, Document_Version__c
                FROM Quote
                WHERE Parent_Quote_Version__c = :quoteId
                ORDER BY CreatedDate DESC
            ];

            Integer count = quoteList.size()+1;
            Quote quote=Database.query(allFields);
            if(quote.Status=='Presented' || quote.Status=='Negotiation' || quote.Status=='Denied') {
                Quote clonedQuote = quote.clone(false, false, false, false);

                quote.Document_Version__c = 'V' + count;
                quote.Approval_Status__c = '';
                quote.Status = 'Draft';
                quote.Name = quote.Name.replaceAll(' V\\d+ ', ' V' + count + ' ');
                quote.Customer_PO_Date__c = null;
                quote.Customer_PO_Number__c = null;
                quote.BypassNameChangeValidation__c = true;
                quote.Quote_Start_Date__c = Date.today();
                quote.Quote_Due_Date__c = Date.today().addDays(3);
                UPDATE quote;

                quote.BypassNameChangeValidation__c = false;
                UPDATE quote;

                System.debug('before clone insert ');
                // Clone the Quote
                clonedQuote.Document_Version__c = 'V'+(count-1);
                clonedQuote.Parent_Quote_Version__c = quote.Id;
                clonedQuote.Status = 'Amended';
                clonedQuote.Quote_Start_Date__c = Date.today();
                clonedQuote.Quote_Due_Date__c = Date.today().addDays(3);

                // Apply history changes to V0 Quote (previous version)
                Set<String> processedFields = new Set<String>();
                Map<String, Schema.SObjectField> quoteFieldMap = Schema.getGlobalDescribe().get('Quote').getDescribe().fields.getMap();
                // Fetch Quote History Tracking Records
                List<QuoteHistory> quoteHistoryList = [SELECT Id,Quote.CreatedDate, DataType, Quote.LastModifiedDate, Field, OldValue, NewValue, CreatedById, CreatedDate
                FROM QuoteHistory
                WHERE QuoteId = :quoteId
                ORDER BY CreatedDate DESC];
                for (QuoteHistory history : quoteHistoryList) {
                    if (!processedFields.contains(history.Field) && history.OldValue!=null && history.OldValue != history.NewValue) {

                        System.debug('inside for changes '+isValueChanged);
                        System.debug('history.Field '+history.Field);

                        if(history.Field =='Contact') {
                            if(history.DataType == 'EntityId') {
                                clonedQuote.put('ContactId', String.valueOf(history.OldValue));
                            }
                        }
                        else{
                            Schema.DescribeFieldResult fieldDescribe = quoteFieldMap.get(history.Field).getDescribe();
                            Schema.DisplayType fieldType = fieldDescribe.getType();

                            if (fieldType == Schema.DisplayType.CURRENCY ||
                                fieldType == Schema.DisplayType.PERCENT ||
                                fieldType == Schema.DisplayType.DOUBLE ||
                                fieldType == Schema.DisplayType.INTEGER) {

                                clonedQuote.put(history.Field, Decimal.valueOf(String.valueOf(history.OldValue)));
                            }
                            else if (fieldType == Schema.DisplayType.BOOLEAN) {
                                clonedQuote.put(history.Field, Boolean.valueOf(String.valueOf(history.OldValue)));
                            }
                            else if (fieldType == Schema.DisplayType.DATE) {
                                clonedQuote.put(history.Field, Date.valueOf(String.valueOf(history.OldValue)));
                            }
                            else if (fieldType == Schema.DisplayType.DATETIME) {
                                clonedQuote.put(history.Field, DateTime.valueOf(String.valueOf(history.OldValue)));
                            }
                            else {
                                clonedQuote.put(history.Field, String.valueOf(history.OldValue));  // Default to String
                            }
                        }
                        processedFields.add(history.Field);
                        isValueChanged=true;
                    }
                }

                clonedQuote.Status = 'Amended';
                INSERT clonedQuote;
                System.debug('aftre clone insert '+isValueChanged);

                System.debug('==> New Quote Created: ' + clonedQuote.Id);

                String parentRecId = quoteId;
                // Fetch existing Quote Line Items
                    String allQuoteLineItemFields = HttpUtils.getOneLevelLineItemRecords('QuoteLineItem', 'QuoteId', parentRecId);
                    List<QuoteLineItem> quoteLineItems = Database.query(allQuoteLineItemFields);

                    // Fetch history tracking for Quote Line Items
                    Set<Id> itemIds = new Set<Id>();
                    for (QuoteLineItem qli : quoteLineItems) {
                        itemIds.add(qli.Id);
                    }

                    List<QuoteLineItemHistory> quoteLineItemHistoryList = [SELECT Id,DataType,QuoteLineItemId,QuoteLineItem.CreatedDate,QuoteLineItem.LastModifiedDate, Field, OldValue, NewValue, CreatedById, CreatedDate
                                                                        FROM QuoteLineItemHistory
                                                                        WHERE  QuoteLineItemId IN:itemIds
                                                                        ORDER BY CreatedDate DESC];

                    // Clone Quote Line Items with modified values
                    List<QuoteLineItem> newQuoteLineItems = new List<QuoteLineItem>();
                    Set<String> fieldNames=new Set<String>();
                    Set<String> lineItemids=new Set<String>();
                    for (QuoteLineItem qli : quoteLineItems) {
                        QuoteLineItem clonedQLI = qli.clone(false, true);
                        clonedQLI.QuoteId = clonedQuote.Id;

                        for (QuoteLineItemHistory history : quoteLineItemHistoryList) {
                            if (history.QuoteLineItemId == qli.Id && !fieldNames.contains(history.Field) && !lineItemids.contains(history.QuoteLineItemId)) {
                                if (history.OldValue!=null && history.OldValue != history.NewValue) {

                                    // Get field describe result safely
                                    Map<String, Schema.SObjectField> fieldMap = Schema.getGlobalDescribe().get('QuoteLineItem').getDescribe().fields.getMap();
                                    Schema.DescribeFieldResult fieldDescribe = fieldMap.get(history.Field).getDescribe();

                                    // Get field type
                                    Schema.DisplayType fieldType = fieldDescribe.getType();

                                    if (fieldType == Schema.DisplayType.CURRENCY ||
                                        fieldType == Schema.DisplayType.PERCENT ||
                                        fieldType == Schema.DisplayType.DOUBLE ||
                                        fieldType == Schema.DisplayType.INTEGER) {

                                        clonedQLI.put(history.Field, history.OldValue!=null? Decimal.valueOf(String.valueOf(history.OldValue)):0);
                                    } else if (fieldType == Schema.DisplayType.BOOLEAN) {
                                        clonedQLI.put(history.Field,history.OldValue!=null?Boolean.valueOf(String.valueOf(history.OldValue)):false);
                                    } else if (fieldType == Schema.DisplayType.DATE) {
                                        clonedQLI.put(history.Field, Date.valueOf(String.valueOf(history.OldValue)));
                                    } else if (fieldType == Schema.DisplayType.DATETIME) {
                                        clonedQLI.put(history.Field, DateTime.valueOf(String.valueOf(history.OldValue)));
                                    } else {
                                        clonedQLI.put(history.Field, String.valueOf(history.OldValue));  // Default to String
                                    }
                                }
                                isValueChanged=true;
                                fieldNames.add(history.Field);
                                lineItemids.add(history.QuoteLineItemId);
                            }
                        }

                        newQuoteLineItems.add(clonedQLI);
                    }

                    INSERT newQuoteLineItems;
                    if(!isValueChanged){
                        DELETE clonedQuote;
                        DELETE newQuoteLineItems;
                        System.debug('inside  '+isValueChanged);
                        return 'No data changed. No need to create new Version.';
                    }
                    List<Quote> qlist=new List<Quote>();
                    qlist.add(clonedQuote);
                    List<Approval.LockResult> lrList = Approval.lock(qlist, false);
                    return 'true ' + clonedQuote.Name + ',' + quote.Id;
                }
                else {
                    return 'Amendment is not applicable for this status ';
                }
            }
            catch (Exception e) {
                System.debug('error ==> '+e.getMessage()+' '+e.getLineNumber());
                throw new AuraHandledException(e.getMessage());
            }
    }



